// Gigsaw data model.
// Postgres in production (Railway) and in local development.
// Enum-like fields are stored as strings; allowed values live in src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A company using Gigsaw. Every artist, contact, venue and booking belongs to one agency,
// and agency staff only ever see their own agency's records.
model Agency {
  id               String   @id @default(cuid())
  name             String
  status           String   @default("ACTIVE") // ACTIVE | SUSPENDED
  // What the platform owner charges this agency for each billable gig.
  pricePerGigMinor Int      @default(0)
  billingCurrency  String   @default("GBP")
  billingEmail     String   @default("")
  ownerNotes       String   @default("") // only the platform owner sees this
  createdAt        DateTime @default(now())

  settings   Settings?
  users      User[]
  artists    Artist[]
  contacts   Contact[]
  venues     Venue[]
  bookings   Booking[]
  activity   Activity[]
  statements BillingStatement[]
  messages   Message[]
  slots      VenueSlot[]
}

// A month's bill for one agency, frozen when the owner issues it.
model BillingStatement {
  id               String    @id @default(cuid())
  agencyId         String
  agency           Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  month            String // "YYYY-MM"
  gigCount         Int
  pricePerGigMinor Int
  amountMinor      Int
  currency         String
  // Booking references counted, so a bill can be checked later.
  references       String    @default("")
  status           String    @default("ISSUED") // ISSUED | PAID
  issuedAt         DateTime  @default(now())
  paidAt           DateTime?

  @@unique([agencyId, month])
}

model Settings {
  agencyId              String  @id
  agency                Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyName            String  @default("My Agency")
  agencyEmail           String  @default("")
  agencyAddress         String  @default("")
  defaultTimezone       String  @default("Europe/London")
  defaultCurrency       String  @default("GBP")
  defaultCommission     Float   @default(15)
  // Minutes after the call time before an arrival counts as late.
  lateGraceMinutes      Int     @default(5)
  // How close (in metres) a check-in must be to the venue to count as "on site".
  geofenceMetres        Int     @default(500)
  // Arrival alerts. The booking's agent is always alerted; these add an on-call contact.
  overdueAlerts         Boolean @default(true)
  alertEmail            String  @default("")
  alertPhone            String  @default("")
  // Tell the client (the booking's promoter or client contact) when the artist arrives.
  clientArrivalMessages Boolean @default(true)
  invoiceTerms          String  @default("Payment due within 14 days of invoice date.")
  contractTerms         String  @default("")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  phone        String   @default("") // for overdue alert texts
  passwordHash String
  role         String   @default("AGENT") // ADMIN | AGENT | ARTIST (within their agency)
  // The platform owner runs the Owner area. They may also belong to an agency.
  isOwner      Boolean  @default(false)
  agencyId     String?
  agency       Agency?  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  artistId     String?  @unique
  artist       Artist?  @relation("ArtistLogin", fields: [artistId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  demo         Boolean  @default(false) // sample data, removable from Settings

  sessions        Session[]
  passwordResets  PasswordReset[]
  managedArtists  Artist[]        @relation("ArtistAgent")
  bookingsCreated Booking[]       @relation("BookingCreator")
  bookingsAgented Booking[]       @relation("BookingAgent")
  notes           ContactNote[]
  checkIns        CheckIn[]
  activity        Activity[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Artist {
  id                String   @id @default(cuid())
  agencyId          String
  agency            Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name              String
  genre             String   @default("")
  email             String   @default("")
  phone             String   @default("")
  colour            String   @default("#6d28d9")
  notes             String   @default("")
  defaultCommission Float?
  // Secret token used for the artist's private calendar (ICS) feed.
  calendarToken     String   @unique @default(cuid())
  agentId           String?
  agent             User?    @relation("ArtistAgent", fields: [agentId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  demo              Boolean  @default(false) // sample data, removable from Settings

  login    User?       @relation("ArtistLogin")
  slots    VenueSlot[]
  bookings Booking[]
  checkIns CheckIn[]

  @@index([agencyId])
}

model Contact {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  type      String   @default("PROMOTER") // PROMOTER | CLIENT | VENUE_CONTACT | COLLABORATOR | OTHER
  name      String
  company   String   @default("")
  email     String   @default("")
  phone     String   @default("")
  address   String   @default("")
  tags      String   @default("") // comma separated
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  demo      Boolean  @default(false) // sample data, removable from Settings

  notes    ContactNote[]
  slots    VenueSlot[]
  bookings Booking[]

  @@index([agencyId])
}

model ContactNote {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())
}

model Venue {
  id         String   @id @default(cuid())
  agencyId   String
  agency     Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name       String
  address    String   @default("")
  city       String   @default("")
  country    String   @default("")
  capacity   Int?
  latitude   Float?
  longitude  Float?
  // Secret for the venue's read-only page (/v/<token>). Null means no link has been made.
  shareToken String?  @unique
  colour     String   @default("") // calendar colour; blank means pick one automatically
  timezone   String   @default("Europe/London")
  notes      String   @default("")
  createdAt  DateTime @default(now())
  demo       Boolean  @default(false) // sample data, removable from Settings

  slots    VenueSlot[]
  bookings Booking[]

  @@index([agencyId])
}

model Booking {
  id          String   @id @default(cuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  reference   String
  eventName   String   @default("")
  status      String   @default("HOLD") // ENQUIRY | HOLD | PENDING | CONFIRMED | SETTLED | CANCELLED
  dealType    String   @default("STANDARD_COMMISSION") // STANDARD_COMMISSION | BUY_SELL | VERSUS | PLUS | FLAT
  eventType   String   @default("GIG") // GIG | FESTIVAL | CLUB_NIGHT | WEDDING | CORPORATE | PRIVATE_PARTY | OTHER
  artistId    String
  artist      Artist   @relation(fields: [artistId], references: [id], onDelete: Restrict)
  venueId     String?
  venue       Venue?   @relation(fields: [venueId], references: [id], onDelete: SetNull)
  promoterId  String?
  promoter    Contact? @relation(fields: [promoterId], references: [id], onDelete: SetNull)
  agentId     String?
  agent       User?    @relation("BookingAgent", fields: [agentId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?    @relation("BookingCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // All times are stored in UTC. They are entered and shown in the venue's time zone.
  timezone     String    @default("Europe/London")
  arriveBy     DateTime // call time / load-in: the time the artist must be at the venue
  soundcheckAt DateTime?
  setStart     DateTime
  setEnd       DateTime?

  // Money is stored in minor units (pence / cents) to avoid rounding errors.
  currency       String    @default("GBP")
  feeMinor       Int       @default(0)
  artistFeeMinor Int? // buy/sell deals: what the agency pays the artist
  commissionPct  Float     @default(15)
  vatPct         Float     @default(0)
  depositMinor   Int       @default(0)
  depositDueDate DateTime?
  dealNotes      String    @default("")

  // Radius clause: no other show for this artist within radiusKm for radiusDays either side.
  radiusKm   Int?
  radiusDays Int?

  // Itinerary
  travel        String @default("")
  accommodation String @default("")
  dayContact    String @default("")
  hospitality   String @default("")
  notes         String @default("")
  tags          String @default("")

  // The weekly venue slot this gig fills, if it came from a venue's music schedule.
  slotId String?
  slot   VenueSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)

  // Messages: send the client an "artist has arrived" note; when alerts went out (sent once).
  notifyClientOnArrival Boolean   @default(true)
  overdueAlertSentAt    DateTime?
  clientNotifiedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  demo      Boolean  @default(false) // sample data, removable from Settings

  payments Payment[]
  checkIns CheckIn[]

  @@unique([agencyId, reference])
  @@index([agencyId, setStart])
  @@index([artistId, setStart])
  @@index([slotId])
}

model Payment {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  direction   String // IN (from promoter) | OUT (paid to artist)
  kind        String   @default("BALANCE") // DEPOSIT | BALANCE | SETTLEMENT | EXPENSE | OTHER
  amountMinor Int
  paidAt      DateTime
  note        String   @default("")
  createdAt   DateTime @default(now())
}

// A musician marking where they are for a gig. ARRIVED is the one that counts for punctuality.
model CheckIn {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  artistId   String
  artist     Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind       String // ON_THE_WAY | ARRIVED | DEPARTED
  source     String   @default("APP") // APP (artist on their phone) | AGENT (logged by the agency)
  at         DateTime @default(now())
  latitude   Float?
  longitude  Float?
  accuracyM  Float?
  distanceM  Float? // distance from the venue at the time of check-in
  etaMinutes Int?
  note       String   @default("")
  createdAt  DateTime @default(now())

  @@index([bookingId, kind])
}

model Activity {
  id        String   @id @default(cuid())
  agencyId  String?
  agency    Agency?  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  entity    String // BOOKING | CONTACT | ARTIST | VENUE | SETTINGS | USER
  entityId  String
  action    String
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

// One-time password reset links. Only a hash of the token is stored.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Every email or text Gigsaw sends (or would send, when no provider is set up).
model Message {
  id        String   @id @default(cuid())
  agencyId  String?
  agency    Agency?  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  bookingId String?
  kind      String // PASSWORD_RESET | OVERDUE_ALERT | CLIENT_ARRIVAL | TEST
  channel   String // EMAIL | SMS
  to        String
  subject   String   @default("")
  body      String
  status    String // SENT | FAILED | NOT_SENT (no provider set up)
  provider  String   @default("")
  error     String   @default("")
  createdAt DateTime @default(now())

  @@index([agencyId, createdAt])
}

// A regular weekly music slot at a venue, e.g. "Mondays 19:00-21:00, solo".
// The rota turns slots into bookings, one per date, when an artist is put in them.
model VenueSlot {
  id            String    @id @default(cuid())
  agencyId      String
  agency        Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  venueId       String
  venue         Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  weekday       Int // 1 = Monday ... 7 = Sunday
  label         String    @default("") // e.g. "Solo", "Duo", "DJ"
  arriveTime    String // "18:30", venue local time
  startTime     String // "19:00"
  endTime       String // "21:00"
  feeMinor      Int       @default(0)
  currency      String    @default("GBP")
  eventType     String    @default("GIG")
  bookingStatus String    @default("CONFIRMED") // status given to gigs made from this slot
  promoterId    String? // who pays, usually the venue's own contact
  promoter      Contact?  @relation(fields: [promoterId], references: [id], onDelete: SetNull)
  artistId      String? // the regular performer, if there is one
  artist        Artist?   @relation(fields: [artistId], references: [id], onDelete: SetNull)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  bookings      Booking[]

  @@index([agencyId, weekday])
  @@index([venueId])
}
