// Gigsaw data model.
// Postgres in production (Railway) and in local development.
// Enum-like fields are stored as strings; allowed values live in src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A company using Gigsaw. Every artist, contact, venue and booking belongs to one agency,
// and agency staff only ever see their own agency's records.
model Agency {
  id                   String   @id @default(cuid())
  name                 String
  status               String   @default("ACTIVE") // ACTIVE | SUSPENDED
  // What the platform owner charges this agency for each billable gig.
  pricePerGigMinor     Int      @default(0)
  billingCurrency      String   @default("GBP")
  // Internal users (admins and agents): this many are included, each extra one costs this a year.
  includedUsers        Int      @default(2)
  extraUserYearlyMinor Int      @default(0)
  billingEmail         String   @default("")
  ownerNotes           String   @default("") // only the platform owner sees this
  createdAt            DateTime @default(now())

  settings     Settings?
  users        User[]
  artists      Artist[]
  contacts     Contact[]
  venues       Venue[]
  bookings     Booking[]
  activity     Activity[]
  statements   BillingStatement[]
  messages     Message[]
  slots        VenueSlot[]
  people       Person[]
  events       Event[]
  applications ActApplication[]
}

// A month's bill for one agency, frozen when the owner issues it.
model BillingStatement {
  id               String    @id @default(cuid())
  agencyId         String
  agency           Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  month            String // "YYYY-MM"
  gigCount         Int
  pricePerGigMinor Int
  // Extra internal users that month, charged at a twelfth of the yearly price each.
  extraUsers       Int       @default(0)
  userChargeMinor  Int       @default(0)
  amountMinor      Int
  currency         String
  // Booking references counted, so a bill can be checked later.
  references       String    @default("")
  status           String    @default("ISSUED") // ISSUED | PAID
  issuedAt         DateTime  @default(now())
  paidAt           DateTime?

  @@unique([agencyId, month])
}

model Settings {
  agencyId              String  @id
  agency                Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyName            String  @default("My Agency")
  agencyEmail           String  @default("")
  agencyAddress         String  @default("")
  defaultTimezone       String  @default("Europe/London")
  defaultCurrency       String  @default("GBP")
  defaultCommission     Float   @default(15)
  // Minutes after the call time before an arrival counts as late.
  lateGraceMinutes      Int     @default(5)
  // Minutes an artist needs to pack down and get going between two gigs, on top of travel.
  changeoverMinutes     Int     @default(15)
  // How close (in metres) a check-in must be to the venue to count as "on site".
  geofenceMetres        Int     @default(500)
  // Arrival alerts. The booking's agent is always alerted; these add an on-call contact.
  overdueAlerts         Boolean @default(true)
  alertEmail            String  @default("")
  alertPhone            String  @default("")
  // Tell the client (the booking's promoter or client contact) when the artist arrives.
  clientArrivalMessages Boolean @default(true)
  // Weddings and events: automatic emails to the customer and the acts, and a review link for the thank-you.
  eventEmails           Boolean @default(true)
  // Tell the customer when an act is confirmed: EVENTS (weddings and private events) | ALL | OFF
  customerConfirmations String  @default("EVENTS")
  reviewLink            String  @default("")
  // A booking fee added to what the client pays, kept in full by the agency (no act's share).
  // 0 means no default fee. Added to: EVENTS (weddings and private events, once per event) | ALL
  bookingFeeMinor       Int     @default(0)
  bookingFeeFor         String  @default("EVENTS")
  // Secret for the private link new acts use to join (/join/<token>). Null means no link yet.
  joinToken             String? @unique
  // Reminders to artists: a weekly list of next week's gigs, and a nudge on the day.
  weeklyReminders       Boolean @default(true)
  weeklyReminderDay     Int     @default(7) // 1 = Monday ... 7 = Sunday
  weeklyReminderTime    String  @default("18:00") // agency's local time
  dayReminders          Boolean @default(true)
  dayReminderTime       String  @default("12:00") // venue's local time
  invoiceTerms          String  @default("Payment due within 14 days of invoice date.")
  contractTerms         String  @default("")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  phone        String   @default("") // for overdue alert texts
  passwordHash String
  role         String   @default("AGENT") // ADMIN | AGENT | ARTIST (within their agency)
  // The platform owner runs the Owner area. They may also belong to an agency.
  isOwner      Boolean  @default(false)
  agencyId     String?
  agency       Agency?  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  artistId     String?  @unique
  artist       Artist?  @relation("ArtistLogin", fields: [artistId], references: [id], onDelete: SetNull)
  // A person's own login: they see the gigs of every act they're in.
  personId     String?  @unique
  person       Person?  @relation("PersonLogin", fields: [personId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  demo         Boolean  @default(false) // sample data, removable from Settings

  sessions          Session[]
  passwordResets    PasswordReset[]
  managedArtists    Artist[]           @relation("ArtistAgent")
  bookingsCreated   Booking[]          @relation("BookingCreator")
  bookingsAgented   Booking[]          @relation("BookingAgent")
  notes             ContactNote[]
  checkIns          CheckIn[]
  activity          Activity[]
  pushSubscriptions PushSubscription[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Artist {
  id                String   @id @default(cuid())
  agencyId          String
  agency            Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  // The record's id in the system it was imported from, e.g. an Overture contact id, so re-importing updates rather than duplicates.
  importRef         String?
  name              String
  genre             String   @default("")
  email             String   @default("")
  phone             String   @default("")
  colour            String   @default("#6d28d9")
  notes             String   @default("")
  defaultCommission Float?
  // Secret token used for the artist's private calendar (ICS) feed.
  calendarToken     String   @unique @default(cuid())
  agentId           String?
  agent             User?    @relation("ArtistAgent", fields: [agentId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  demo              Boolean  @default(false) // sample data, removable from Settings

  // Profile, filled in by the act when they join or by the agency.
  actType           String  @default("") // SOLO | DUO | BAND | DJ | OTHER
  town              String  @default("")
  photoUrl          String  @default("")
  videoUrl          String  @default("")
  instagram         String  @default("")
  website           String  @default("")
  setList           String  @default("")
  usualFeeMinor     Int? // what they usually charge, a guide for the agency
  // Bank details for paying the act. Agency only.
  bankAccountName   String  @default("")
  bankSortCode      String  @default("")
  bankAccountNumber String  @default("")
  vatRegistered     Boolean @default(false)
  vatNumber         String  @default("")

  login    User?       @relation("ArtistLogin")
  slots    VenueSlot[]
  bookings Booking[]
  checkIns CheckIn[]
  members  PersonAct[]
  // A band built from other acts, e.g. Wonderlust = Graham McKee Solo + Jo Drummond Solo.
  partActs ActLink[]   @relation("ActParent")
  partOf   ActLink[]   @relation("ActChild")

  @@index([agencyId, importRef])
  @@index([agencyId])
}

model Contact {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  // The record's id in the system it was imported from, e.g. an Overture contact id, so re-importing updates rather than duplicates.
  importRef String?
  type      String   @default("PROMOTER") // PROMOTER | CLIENT | VENUE_CONTACT | COLLABORATOR | OTHER
  name      String
  company   String   @default("")
  email     String   @default("")
  phone     String   @default("")
  address   String   @default("")
  tags      String   @default("") // comma separated
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  demo      Boolean  @default(false) // sample data, removable from Settings

  notes    ContactNote[]
  slots    VenueSlot[]
  bookings Booking[]
  people   Person[]
  events   Event[]

  @@index([agencyId, importRef])
  @@index([agencyId])
}

model ContactNote {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())
}

model Venue {
  id         String   @id @default(cuid())
  agencyId   String
  agency     Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  // The record's id in the system it was imported from, e.g. an Overture contact id, so re-importing updates rather than duplicates.
  importRef  String?
  name       String
  address    String   @default("")
  city       String   @default("")
  country    String   @default("")
  capacity   Int?
  latitude   Float?
  longitude  Float?
  // Secret for the venue's read-only page (/v/<token>). Null means no link has been made.
  shareToken String?  @unique
  colour     String   @default("") // calendar colour; blank means pick one automatically
  timezone   String   @default("Europe/London")
  notes      String   @default("")
  createdAt  DateTime @default(now())
  demo       Boolean  @default(false) // sample data, removable from Settings

  slots    VenueSlot[]
  bookings Booking[]
  people   Person[]
  events   Event[]

  @@index([agencyId, importRef])
  @@index([agencyId])
}

model Booking {
  id          String   @id @default(cuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  reference   String
  eventName   String   @default("")
  // ENQUIRY | PENDING (being set up, maybe no act yet) | AWAITING (offered to the act) |
  // HOLD | CONFIRMED (the act has accepted: the gig is on) | SETTLED | CANCELLED
  status      String   @default("PENDING")
  dealType    String   @default("BUY_SELL") // BUY_SELL (sale and cost, the normal case) | STANDARD_COMMISSION | VERSUS | PLUS | FLAT
  eventType   String   @default("GIG") // GIG | FESTIVAL | CLUB_NIGHT | WEDDING | CORPORATE | PRIVATE_PARTY | OTHER
  // The act. Empty while the gig is being set up ("Needs an act").
  artistId    String?
  artist      Artist?  @relation(fields: [artistId], references: [id], onDelete: Restrict)
  venueId     String?
  venue       Venue?   @relation(fields: [venueId], references: [id], onDelete: SetNull)
  promoterId  String?
  promoter    Contact? @relation(fields: [promoterId], references: [id], onDelete: SetNull)
  agentId     String?
  agent       User?    @relation("BookingAgent", fields: [agentId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?    @relation("BookingCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // All times are stored in UTC. They are entered and shown in the venue's time zone.
  timezone     String    @default("Europe/London")
  arriveBy     DateTime // call time / load-in: the time the artist must be at the venue
  soundcheckAt DateTime?
  setStart     DateTime
  setEnd       DateTime?

  // Money is stored in minor units (pence / cents) to avoid rounding errors.
  currency        String    @default("GBP")
  feeMinor        Int       @default(0)
  artistFeeMinor  Int? // buy/sell deals: what the agency pays the artist
  commissionPct   Float     @default(15)
  vatPct          Float     @default(0)
  bookingFeeMinor Int       @default(0) // charged to the venue or client on top, all ours; acts never see it
  depositMinor    Int       @default(0)
  depositDueDate  DateTime?
  dealNotes       String    @default("")

  // Radius clause: no other show for this artist within radiusKm for radiusDays either side.
  radiusKm   Int?
  radiusDays Int?

  // Itinerary
  travel        String @default("")
  accommodation String @default("")
  dayContact    String @default("")
  hospitality   String @default("")
  notes         String @default("")
  tags          String @default("")

  // The wedding or event this gig is part of (one customer booking with several acts).
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  // The weekly venue slot this gig fills, if it came from a venue's music schedule.
  slotId String?
  slot   VenueSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)

  // Messages: send the client an "artist has arrived" note; when alerts went out (sent once).
  // Offer to the act: a private accept/decline link, and their answer.
  offerToken     String?   @unique
  offeredAt      DateTime?
  offerResponse  String? // ACCEPTED | DECLINED
  respondedAt    DateTime?
  // When the customer (weddings and private events) was told this act is confirmed.
  customerToldAt DateTime?

  notifyClientOnArrival Boolean   @default(true)
  overdueAlertSentAt    DateTime?
  clientNotifiedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  demo      Boolean  @default(false) // sample data, removable from Settings

  payments Payment[]
  checkIns CheckIn[]

  @@unique([agencyId, reference])
  @@index([agencyId, setStart])
  @@index([artistId, setStart])
  @@index([slotId])
  @@index([eventId])
}

model Payment {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  direction   String // IN (from promoter) | OUT (paid to artist)
  kind        String   @default("BALANCE") // DEPOSIT | BALANCE | SETTLEMENT | EXPENSE | OTHER
  amountMinor Int
  paidAt      DateTime
  note        String   @default("")
  createdAt   DateTime @default(now())
}

// A musician marking where they are for a gig. ARRIVED is the one that counts for punctuality.
model CheckIn {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  artistId   String
  artist     Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind       String // ON_THE_WAY | ARRIVED | DEPARTED
  source     String   @default("APP") // APP (artist on their phone) | AGENT (logged by the agency)
  at         DateTime @default(now())
  latitude   Float?
  longitude  Float?
  accuracyM  Float?
  distanceM  Float? // distance from the venue at the time of check-in
  etaMinutes Int?
  note       String   @default("")
  createdAt  DateTime @default(now())

  @@index([bookingId, kind])
}

model Activity {
  id        String   @id @default(cuid())
  agencyId  String?
  agency    Agency?  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  entity    String // BOOKING | CONTACT | ARTIST | VENUE | SETTINGS | USER
  entityId  String
  action    String
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

// One-time password reset links. Only a hash of the token is stored.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Every email or text Gigsaw sends (or would send, when no provider is set up).
model Message {
  id        String   @id @default(cuid())
  agencyId  String?
  agency    Agency?  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  bookingId String?
  kind      String // PASSWORD_RESET | OVERDUE_ALERT | CLIENT_ARRIVAL | BOOKING_CHANGE | REMINDER | TEST
  channel   String // EMAIL | SMS | PUSH
  to        String
  subject   String   @default("")
  body      String
  status    String // SENT | FAILED | NOT_SENT (no provider set up)
  provider  String   @default("")
  error     String   @default("")
  createdAt DateTime @default(now())

  @@index([agencyId, createdAt])
}

// A regular weekly music slot at a venue, e.g. "Mondays 19:00-21:00, solo".
// The rota turns slots into bookings, one per date, when an artist is put in them.
model VenueSlot {
  id            String    @id @default(cuid())
  agencyId      String
  agency        Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  venueId       String
  venue         Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  weekday       Int // 1 = Monday ... 7 = Sunday
  label         String    @default("") // e.g. "Solo", "Duo", "DJ"
  arriveTime    String // "18:30", venue local time
  startTime     String // "19:00"
  endTime       String // "21:00"
  feeMinor      Int       @default(0) // sale: what the venue or customer pays
  costMinor     Int? // cost: the act's fee, when the agency works on sale and cost (blank = commission)
  currency      String    @default("GBP")
  eventType     String    @default("GIG")
  bookingStatus String    @default("CONFIRMED") // status given to gigs made from this slot
  promoterId    String? // who pays, usually the venue's own contact
  promoter      Contact?  @relation(fields: [promoterId], references: [id], onDelete: SetNull)
  artistId      String? // the regular performer, if there is one
  artist        Artist?   @relation(fields: [artistId], references: [id], onDelete: SetNull)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  bookings      Booking[]

  @@index([agencyId, weekday])
  @@index([venueId])
}

// A phone or browser that has turned on notifications (web push) for a login.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  device    String   @default("") // e.g. "iPhone", for the artist's own reference
  createdAt DateTime @default(now())

  @@index([userId])
}

// Site-wide generated secrets, e.g. the web push (VAPID) keys.
model AppSecret {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
}

// Records each reminder sent so it only goes once, e.g. ("WEEK", "person:abc", "2026-11-02").
// The recipient is "person:<id>" for an act member, or "act:<id>" for an act with no members.
model Reminder {
  id        String   @id @default(cuid())
  kind      String // WEEK | DAY
  recipient String
  key       String
  createdAt DateTime @default(now())

  @@unique([kind, recipient, key])
}

// A person: a musician in one or more acts, a venue manager, someone at a promoter, and so on.
// Their company is either a venue or another company (a contact).
model Person {
  id            String      @id @default(cuid())
  agencyId      String
  agency        Agency      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  // The record's id in the system it was imported from, e.g. an Overture contact id, so re-importing updates rather than duplicates.
  importRef     String?
  firstName     String
  surname       String      @default("")
  alias         String      @default("") // stage or known-as name
  pronouns      String      @default("")
  email         String      @default("")
  phone         String      @default("")
  social        String      @default("")
  website       String      @default("")
  address       String      @default("")
  notes         String      @default("")
  venueId       String?
  venue         Venue?      @relation(fields: [venueId], references: [id], onDelete: SetNull)
  companyId     String?
  company       Contact?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  jobTitle      String      @default("") // their role at the venue or company, e.g. "General manager"
  calendarToken String      @unique @default(cuid())
  demo          Boolean     @default(false)
  createdAt     DateTime    @default(now())
  acts          PersonAct[]
  login         User?       @relation("PersonLogin")

  @@index([agencyId, importRef])
  @@index([agencyId])
  @@index([venueId])
}

// A person's place in an act, e.g. Graham McKee, lead vocals, in Wonderlust.
model PersonAct {
  id       String @id @default(cuid())
  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  artistId String
  act      Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  jobTitle String @default("")

  @@unique([personId, artistId])
  @@index([artistId])
}

// A wedding or other event: one customer booking that can include several acts. Each act's gig
// is a normal booking linked here, so acts only ever see their own gig and fee, while the
// customer's money is added up across all of them.
model Event {
  id         String   @id @default(cuid())
  agencyId   String
  agency     Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name       String // e.g. "Hannah & Sam's wedding"
  type       String   @default("WEDDING") // WEDDING | CORPORATE | PRIVATE_PARTY | OTHER
  date       String // "YYYY-MM-DD", the day of the event
  timezone   String   @default("Europe/London")
  customerId String?
  customer   Contact? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  venueId    String?
  venue      Venue?   @relation(fields: [venueId], references: [id], onDelete: SetNull)
  venueText  String   @default("") // a venue not on file, e.g. a marquee at a farm
  agentId    String?
  status     String   @default("ACTIVE") // ACTIVE | CANCELLED
  notes      String   @default("") // agency only

  // The plan, filled in by the agency or by the customer using their planner link. Acts see it.
  guestCount    Int?
  timeline      String    @default("") // ceremony, drinks, dinner, speeches, first dance…
  dayContact    String    @default("") // name and number on the day
  arrivalInfo   String    @default("") // parking, load-in, access
  dressCode     String    @default("")
  meals         String    @default("") // food and drink for the acts
  songRequests  String    @default("") // first dance, must-plays, do-not-plays
  specialNotes  String    @default("")
  plannerToken  String?   @unique
  plannerSentAt DateTime?
  plannerDoneAt DateTime?

  autoEmails Boolean     @default(true) // automatic emails to the customer for this event
  demo       Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  bookings   Booking[]
  tasks      EventTask[]

  @@index([agencyId, date])
}

// One item on an event's checklist, e.g. "Deposit received". Some tick themselves (key set).
model EventTask {
  id      String    @id @default(cuid())
  eventId String
  event   Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title   String
  key     String    @default("") // CONTRACT | DEPOSIT | PLANNER | BALANCE | ITINERARY | THANKS, or "" for your own
  dueDate String? // "YYYY-MM-DD"
  doneAt  DateTime?
  sort    Int       @default(0)

  @@index([eventId])
}

// One act inside another, e.g. the solo act "Graham McKee Solo" (child) in the band "Wonderlust" (parent).
model ActLink {
  id       String @id @default(cuid())
  parentId String
  parent   Artist @relation("ActParent", fields: [parentId], references: [id], onDelete: Cascade)
  childId  String
  child    Artist @relation("ActChild", fields: [childId], references: [id], onDelete: Cascade)
  role     String @default("") // e.g. "Lead vocals"

  @@unique([parentId, childId])
  @@index([childId])
}

// A new act filling in the private join link. The agency approves it to create the act (with its
// members and a login), or declines it.
model ActApplication {
  id         String    @id @default(cuid())
  agencyId   String
  agency     Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  status     String    @default("NEW") // NEW | APPROVED | DECLINED
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  artistId   String? // the act made on approval

  actName     String
  actType     String @default("SOLO")
  genre       String @default("")
  town        String @default("")
  contactName String
  email       String
  phone       String @default("")
  members     Json   @default("[]") // [{ name, email, phone, role }]

  photoUrl  String @default("")
  videoUrl  String @default("")
  instagram String @default("")
  website   String @default("")
  setList   String @default("")

  usualFeeMinor     Int?
  bankAccountName   String  @default("")
  bankSortCode      String  @default("")
  bankAccountNumber String  @default("")
  vatRegistered     Boolean @default(false)
  vatNumber         String  @default("")
  notes             String  @default("")
  // The password they chose, so they can log in once approved.
  passwordHash      String

  @@index([agencyId, status])
}
