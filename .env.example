# Gigsaw's settings. Copy this file to .env for local development; on Railway, set them in the
# service's Variables tab. Only DATABASE_URL is needed to run Gigsaw locally. In production the
# server also needs a public address (APP_URL or Railway's own domain) and won't start without
# one. Everything else is optional: a provider that isn't set up is simply off, and the server
# warns once at start-up about any provider that is only half set up.
#
# All of these are read in one place, src/server/env.ts.

# ------------------------------------------------------------------------------------------------
# Essentials
# ------------------------------------------------------------------------------------------------

# Postgres connection. On Railway, set it to ${{Postgres.DATABASE_URL}} (a reference variable).
# Locally, run Postgres (for example with Docker, see README) and point this at it.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gigsaw"

# The site's public address, used in links in emails and texts and in the sign-in redirect
# addresses. Set it when you use your own domain. If it's not set, Railway's own domain
# (RAILWAY_PUBLIC_DOMAIN, which Railway sets once you generate a domain) is used; locally it's
# http://localhost:<PORT>. A bare domain like gigsaw.live is taken as https://gigsaw.live.
# APP_URL="https://gigsaw.live"

# Set by Railway itself (Settings, Networking, Generate Domain). Don't set it by hand.
# RAILWAY_PUBLIC_DOMAIN="gigsaw-production.up.railway.app"

# Set by Railway and by `next start`/`next dev`. Locally, the port defaults to 3000.
# PORT=3000
# NODE_ENV=production

# ------------------------------------------------------------------------------------------------
# Email (Resend, https://resend.com). Both are needed; until then emails are kept in the Outbox.
# ------------------------------------------------------------------------------------------------

# RESEND_API_KEY="re_..."
# The sending address; its domain must be verified in Resend. Replies go to the agency's own email.
# MAIL_FROM="Gigsaw <bookings@send.gigsaw.live>"

# ------------------------------------------------------------------------------------------------
# Texts (Twilio, https://www.twilio.com). All three are needed.
# ------------------------------------------------------------------------------------------------

# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# Your Twilio number.
# TWILIO_FROM="+447700900000"

# ------------------------------------------------------------------------------------------------
# Card subscriptions and card payments (Stripe). Keys pasted in the Owner area (Owner, Stripe)
# take priority over these; these are the fallback.
# ------------------------------------------------------------------------------------------------

# STRIPE_SECRET_KEY="sk_live_..."
# Signing secret of the webhook endpoint <your site>/api/stripe/webhook.
# STRIPE_WEBHOOK_SECRET="whsec_..."
# Signing secret of the Connect webhook endpoint <your site>/api/stripe/connect-webhook.
# STRIPE_CONNECT_WEBHOOK_SECRET="whsec_..."

# ------------------------------------------------------------------------------------------------
# Sign in with Google or Microsoft. Each provider needs both its id and secret; its buttons only
# show once both are set. Redirect addresses: <APP_URL>/api/auth/google/callback and
# <APP_URL>/api/auth/microsoft/callback.
# ------------------------------------------------------------------------------------------------

# GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="..."
# MICROSOFT_CLIENT_ID="..."
# MICROSOFT_CLIENT_SECRET="..."

# ------------------------------------------------------------------------------------------------
# Phone notifications (web push). Optional: if not set, Gigsaw makes a pair of keys once and keeps
# it in the database. Changing them means every phone has to turn reminders on again.
# ------------------------------------------------------------------------------------------------

# VAPID_PUBLIC_KEY="..."
# VAPID_PRIVATE_KEY="..."

# ------------------------------------------------------------------------------------------------
# Background checks (late arrivals, gig reminders, wedding and event emails)
# ------------------------------------------------------------------------------------------------

# --- Calendar connect (optional) ---
# Lets acts connect their own Google or Outlook calendar so Gigsaw puts their gigs straight into it.
# Uses the same Google and Microsoft apps as sign-in (GOOGLE_CLIENT_ID etc.), with calendar access
# added; see docs/calendar-connect.md for the setup. This key encrypts the stored calendar tokens.
# Make one with: openssl rand -base64 32. Changing it means every act has to connect again.
# CALENDAR_TOKEN_KEY="..."

# Set to 1 to turn off the built-in checker that runs every minute, and call
# POST /api/cron/overdue with "Authorization: Bearer <CRON_SECRET>" from your own scheduler instead.
# DISABLE_SCHEDULER=1
# At least 16 random characters. Without it, /api/cron/overdue always refuses.
# CRON_SECRET="..."

# ------------------------------------------------------------------------------------------------
# Secrets Gigsaw otherwise makes itself
# ------------------------------------------------------------------------------------------------

# Signs the enquiry form's time stamp. If not set, Gigsaw makes one and keeps it in the database,
# which is fine for most installs.
# ENQUIRY_SECRET="..."

# ------------------------------------------------------------------------------------------------
# Logs and error reporting
# ------------------------------------------------------------------------------------------------

# Least important log level written: debug, info (the default), warn or error. Production logs
# are one JSON line each; development logs are short readable lines.
# LOG_LEVEL=info

# Optional. Server errors are also sent to Sentry (https://sentry.io) when this is set. Find it
# in Sentry under Project settings, Client keys (DSN).
# SENTRY_DSN="https://<key>@o0.ingest.sentry.io/<project>"

# ------------------------------------------------------------------------------------------------
# Testing only. Both are ignored in production.
# ------------------------------------------------------------------------------------------------

# Send Stripe calls to a stand-in server.
# STRIPE_API_BASE="http://localhost:4242"
# Send Google and Microsoft sign-ins to a stand-in server.
# OAUTH_TEST_BASE="http://localhost:4245"
# A scratch database for the database tests (tests/archive.test.ts).
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gigsaw_test"
